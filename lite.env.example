# WeKnora Lite 部署配置模板：复制为 .env.lite 后按需改
# .env.lite 被 .gitignore 的 `.*` 规则忽略，密钥不会入库
# WeKnora Lite — LAN 虚机部署
GIN_MODE=release
LOG_LEVEL=info
LOG_PATH=./logs/weknora.log

# 数据库（SQLite，单文件）
DB_DRIVER=sqlite
DB_PATH=./data/weknora.db

# 检索：SQLite（FTS5 + 向量）
RETRIEVE_DRIVER=sqlite

# 文件存储
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# 流管理走内存，无需 Redis
STREAM_MANAGER_TYPE=memory

# 安全
SYSTEM_AES_KEY=<openssl rand -hex 16>
JWT_SECRET=<openssl rand -hex 32>

# 功能开关
NEO4J_ENABLE=false
ENABLE_GRAPH_RAG=false
WEKNORA_SANDBOX_MODE=disabled
DISABLE_REGISTRATION=false
CONCURRENCY_POOL_SIZE=6

# 出站白名单（模型 API 域名）
SSRF_WHITELIST_EXTRA=api.deepseek.com,api.siliconflow.cn,127.0.0.1,localhost
